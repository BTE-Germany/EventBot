generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           BigInt  @id @db.BigInt
  banned       Boolean @default(false)
  minecraft_id String  @unique
  points       Float   @default(0)
}

model Build {
  id                Int      @id @default(autoincrement())
  message           BigInt?  @db.BigInt
  judge_msg         BigInt?  @db.BigInt
  location          String
  A                 Float    @default(0)
  B                 Float    @default(0)
  base_points       Float    @default(0)
  reference_type    String?
  reference_link    String?
  judge_details     Json?
  extra_info        String?
  builder_id        BigInt   @db.BigInt
  judges            String[]
  images            String[]
  created_timestamp DateTime @default(now()) @db.Timestamptz(1)
}

// Activity log shown on the status page: registrations, submissions, judging, point changes
model Activity {
  id         Int      @id @default(autoincrement())
  created_at DateTime @default(now()) @db.Timestamptz(1)
  type       String
  build_id   Int?
  user_id    BigInt?  @db.BigInt
  actor      String?
  points     Float?
  details    String?
}
